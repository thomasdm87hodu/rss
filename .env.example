OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
FRAMER_API_KEY=
FRAMER_PROJECT_URL=https://framer.com/projects/BibliWatch--CIvjMsjQrZM82VnQbyfP-hYBk8
TELEGRAM_BOT_TOKEN=
# Dedicated token for the share-buttons bot. Do not reuse the BIN/review bot token.
TELEGRAM_SHARE_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=
# Optional: defaults to bin_dailyupdate
TELEGRAM_CHANNEL=bin_dailyupdate
# Optional: defaults to 20
MAX_TELEGRAM_PAGES=20

# Telegram share-buttons webhook
TELEGRAM_ALLOWED_CHANNEL_USERNAME=@breakingisraelnews
# Optional alternative or additional allow-list check, e.g. -1001234567890
TELEGRAM_ALLOWED_CHANNEL_ID=
# BotFather username, without @; used by the optional promotional button.
BOT_USERNAME=biblishare_bot
# Used both to authenticate incoming webhook requests and by the setup script.
TELEGRAM_WEBHOOK_SECRET=
# Deployed HTTPS origin, e.g. https://your-project.vercel.app
PUBLIC_BASE_URL=
# auto (try copy_text, fall back if Telegram rejects it), copy_text, or fallback
TELEGRAM_COPY_TEXT=auto
# Private v1 default. Set true only when public onboarding is intentionally enabled.
SHOW_ADD_TO_CHANNEL_BUTTON=false
